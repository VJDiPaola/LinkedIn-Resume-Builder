# Required for OpenAI model calls (e.g. /api/optimize)
OPENAI_API_KEY=

# Required in production for distributed rate limiting. Optional for local dev (in-memory fallback).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Required in production for signed session cookies. Use a long random string (e.g. 32+ chars).
SESSION_SECRET=

# PostHog analytics (client-side, must start with NEXT_PUBLIC_)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional; defaults to development when not set.
# NODE_ENV=development
